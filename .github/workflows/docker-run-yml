name: Rodar Nginx no Docker

on:
  push:
    branches:
      - main

jobs:
  run-container:
    runs-on: ubuntu-latest
    steps:
      - name: Rodar contêiner Nginx via SSH
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.AZURE_HOST }}
          username: ${{ secrets.AZURE_USER }}
          key: ${{ secrets.AZURE_SSH_KEY }}
          script: |
            echo "Parando contêiner antigo se existir..."
            sudo docker stop webserver || true
            sudo docker rm webserver || true
            
            echo "Iniciando novo contêiner Nginx..."
            sudo docker run -d -p 80:80 --name webserver nginx
            
            echo "Contêiner rodando com sucesso!"
            sudo docker ps
